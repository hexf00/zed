+/// Calculate the digest of each rustc `--extern` dependency file on
+/// background threads in `pool`.
+///
+/// MSVC-linked images (proc-macro and dylib `dll`s) carry link-time metadata
+/// that changes on every link even when all inputs are identical: the COFF
+/// and debug-directory `TimeDateStamp` fields, the CodeView RSDS GUID and
+/// PDB age, the export-directory timestamp, and the `REPRO` payload hashes.
+/// Hashing those bytes keys every dependent crate's cache entry to the wall
+/// clock, so they are zeroed before hashing. Non-PE files (rlibs, rmeta) are
+/// hashed as-is, and any PE parsing surprise falls back to the plain file
+/// digest: normalization must never fail a compilation.
+pub async fn hash_all_externs(
+    files: &[PathBuf],
+    pool: &tokio::runtime::Handle,
+) -> Result<Vec<String>> {
+    let start = time::Instant::now();
+    let count = files.len();
+    let iter = files.iter().map(|f| {
+        let f = f.clone();
+        let pool = pool.clone();
+        async move {
+            let f2 = f.clone();
+            let normalized = pool
+                .spawn_blocking(move || normalized_extern_image_digest(&f2))
+                .await??;
+            match normalized {
+                Some(digest) => Ok(digest),
+                None => Digest::file(&f, &pool).await,
+            }
+        }
+    });
+    let hashes = futures::future::try_join_all(iter).await?;
+    trace!(
+        "Hashed {} extern files in {}",
+        count,
+        fmt_duration_as_secs(&start.elapsed())
+    );
+    Ok(hashes)
+}
+
+/// Digest of a `--extern` file with PE link-time metadata normalized to
+/// zero, or `None` when the file is not a PE image or cannot be normalized.
+fn normalized_extern_image_digest(path: &Path) -> Result<Option<String>> {
+    let mut file = fs::File::open(path)
+        .with_context(|| format!("Failed to open file for hashing: {:?}", path))?;
+    let mut magic = [0u8; 2];
+    if file.read_exact(&mut magic).is_err() || &magic != b"MZ" {
+        return Ok(None);
+    }
+    // rewind: read_exact above consumed the magic bytes, and the normalizer
+    // needs the WHOLE image with original offsets.
+    file.rewind()
+        .with_context(|| format!("Failed to rewind file for hashing: {:?}", path))?;
+    let mut data = Vec::new();
+    file.read_to_end(&mut data)
+        .with_context(|| format!("Failed to read file for hashing: {:?}", path))?;
+    if let Err(e) = normalize_pe_volatile_bytes(&mut data) {
+        debug!(
+            "[extern PE normalize failed on {:?}, falling back to raw digest: {}]",
+            path, e
+        );
+        return Ok(None);
+    }
+    let mut digest = Digest::new();
+    digest.update(&data);
+    Ok(Some(digest.finish()))
+}
+
+fn pe_u16(data: &[u8], off: usize) -> Result<u16> {
+    Ok(u16::from_le_bytes(
+        data.get(off..off + 2)
+            .ok_or_else(|| anyhow!("PE header truncated"))?
+            .try_into()
+            .unwrap(),
+    ))
+}
+
+fn pe_u32(data: &[u8], off: usize) -> Result<u32> {
+    Ok(u32::from_le_bytes(
+        data.get(off..off + 4)
+            .ok_or_else(|| anyhow!("PE header truncated"))?
+            .try_into()
+            .unwrap(),
+    ))
+}
+
+fn pe_zero(data: &mut [u8], off: usize, len: usize) -> Result<()> {
+    data.get_mut(off..off + len)
+        .ok_or_else(|| anyhow!("PE range out of bounds"))
+        .map(|b| b.fill(0))
+}
+
+/// Map an RVA to a file offset via the section table
+/// `(vaddr, vsize, rawsize, rawaddr)` tuples.
+fn pe_rva_to_offset(sections: &[(u32, u32, u32, u32)], rva: u32) -> Option<usize> {
+    sections
+        .iter()
+        .find(|&&(vaddr, vsize, rsize, _)| {
+            rva >= vaddr && rva < vaddr.saturating_add(vsize.max(rsize))
+        })
+        .map(|&(vaddr, _, _, raddr)| raddr as usize + (rva - vaddr) as usize)
+}
+
+/// File offset and size of data directory `i`, or `None` when absent.
+fn pe_data_dir(
+    data: &[u8],
+    nrva: usize,
+    dd_off: usize,
+    sections: &[(u32, u32, u32, u32)],
+    i: usize,
+) -> Result<Option<(usize, usize)>> {
+    if i >= nrva {
+        return Ok(None);
+    }
+    let rva = pe_u32(data, dd_off + i * 8)?;
+    let size = pe_u32(data, dd_off + i * 8 + 4)? as usize;
+    if rva == 0 || size == 0 {
+        return Ok(None);
+    }
+    Ok(pe_rva_to_offset(sections, rva).map(|off| (off, size)))
+}
+
+/// Zero the link-time-volatile bytes of a PE image in place.
+///
+/// Covers every field observed (or documented) to vary between links of
+/// identical inputs by MSVC link.exe: the COFF header timestamp, the export
+/// directory and import descriptor timestamps, the debug directory entry
+/// timestamps, the CodeView RSDS GUID + PDB age, `REPRO` payload hashes, and
+/// the bound import directory. Returns `Err` when the buffer is not a PE
+/// image with a layout this function understands.
+fn normalize_pe_volatile_bytes(data: &mut [u8]) -> Result<()> {
+    let e_lfanew = pe_u32(data, 0x3c)? as usize;
+    if data.get(e_lfanew..e_lfanew + 4) != Some(b"PE\0\0") {
+        bail!("not a PE image");
+    }
+    let coff = e_lfanew + 4;
+    // COFF header: Machine(2) NumberOfSections(2) TimeDateStamp(4) ...
+    pe_zero(data, coff + 4, 4)?;
+    let nsections = pe_u16(data, coff + 2)? as usize;
+    let opt_size = pe_u16(data, coff + 16)? as usize;
+    let opt = coff + 20;
+    let magic = pe_u16(data, opt)?;
+    let (nrva_off, dd_off) = match magic {
+        0x20b => (opt + 108, opt + 112), // PE32+
+        0x10b => (opt + 92, opt + 96),   // PE32
+        _ => bail!("unknown optional header magic"),
+    };
+    let nrva = pe_u32(data, nrva_off)? as usize;
+    let sections_off = opt + opt_size;
+    let mut sections = Vec::with_capacity(nsections);
+    for s in 0..nsections {
+        let s = sections_off + s * 40;
+        // Section header: Name(8) VirtualSize(4) VirtualAddress(4)
+        // SizeOfRawData(4) PointerToRawData(4).
+        let vsize = pe_u32(data, s + 8)?;
+        let vaddr = pe_u32(data, s + 12)?;
+        let rsize = pe_u32(data, s + 16)?;
+        let raddr = pe_u32(data, s + 20)?;
+        sections.push((vaddr, vsize, rsize, raddr));
+    }
+    // Export directory (index 0): TimeDateStamp at +4.
+    if let Some((off, _)) = pe_data_dir(data, nrva, dd_off, &sections, 0)? {
+        pe_zero(data, off + 4, 4)?;
+    }
+    // Import directory (index 1): zero TimeDateStamp of each
+    // IMAGE_IMPORT_DESCRIPTOR (20 bytes, ts at +4, until an all-zero entry).
+    if let Some((off, size)) = pe_data_dir(data, nrva, dd_off, &sections, 1)? {
+        let mut i = 0;
+        while i + 20 <= size {
+            if data[off + i..off + i + 20].iter().all(|&b| b == 0) {
+                break;
+            }
+            pe_zero(data, off + i + 4, 4)?;
+            i += 20;
+        }
+    }
+    // Debug directory (index 6): zero each entry's TimeDateStamp, plus the
+    // CodeView RSDS GUID+PDB age and the whole REPRO payload.
+    if let Some((off, size)) = pe_data_dir(data, nrva, dd_off, &sections, 6)? {
+        let mut i = 0;
+        while i + 28 <= size {
+            pe_zero(data, off + i + 4, 4)?;
+            let entry_type = pe_u32(data, off + i + 12)?;
+            let payload_size = pe_u32(data, off + i + 16)? as usize;
+            let payload_off = pe_u32(data, off + i + 24)? as usize;
+            match entry_type {
+                // IMAGE_DEBUG_TYPE_CODEVIEW
+                2 if payload_size >= 24 => {
+                    if data.get(payload_off..payload_off + 4) == Some(b"RSDS") {
+                        // Zero GUID (4..20) and PDB age (20..24).
+                        pe_zero(data, payload_off + 4, 20)?;
+                    }
+                }
+                // IMAGE_DEBUG_TYPE_REPRO: whole payload is an input hash.
+                16 => pe_zero(data, payload_off, payload_size)?,
+                _ => {}
+            }
+            i += 28;
+        }
+    }
+    // Bound import directory (index 11): metadata-only optimization, zero it.
+    if let Some((off, size)) = pe_data_dir(data, nrva, dd_off, &sections, 11)? {
+        pe_zero(data, off, size)?;
+    }
+    Ok(())
+}
