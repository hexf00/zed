+/// A GHA-backend-only storage (no disk level) for the fork chunk
+/// transport, built from the same env config the server uses.
+fn fork_gha_storage(
+    config: &Config,
+    pool: &tokio::runtime::Handle,
+) -> Result<std::sync::Arc<dyn Storage>> {
+    let cache = config
+        .cache
+        .as_ref()
+        .ok_or_else(|| anyhow!("no cache backend configured"))?;
+    let gha = cache
+        .gha
+        .as_ref()
+        .ok_or_else(|| anyhow!("gha cache is not configured"))?;
+    let cache_type = crate::config::CacheType::GHA(gha.clone());
+    build_single_cache(&cache_type, &config.basedirs, pool, config.skip_cache_check)
+}
+
+#[derive(serde::Serialize, serde::Deserialize)]
+struct ForkChunkEntry {
+    k: String,
+    off: u64,
+    len: u64,
+}
+
+#[derive(serde::Serialize, serde::Deserialize)]
+struct ForkChunk {
+    key: String,
+    size: u64,
+    entries: Vec<ForkChunkEntry>,
+}
+
+#[derive(serde::Serialize, serde::Deserialize)]
+struct ForkChunkIndex {
+    chunks: Vec<ForkChunk>,
+}
+
+/// Build a chunk (manifest + key) from a group of store entries.
+fn fork_build_chunk(group: &[(String, std::path::PathBuf, u64)]) -> Result<ForkChunk> {
+    let mut hasher = crate::util::Digest::new();
+    let mut entries = Vec::with_capacity(group.len());
+    let mut off = 0u64;
+    for (key, _, len) in group {
+        hasher.update(key.as_bytes());
+        entries.push(ForkChunkEntry {
+            k: key.clone(),
+            off,
+            len: *len,
+        });
+        off += len;
+    }
+    Ok(ForkChunk {
+        key: hasher.finish(),
+        size: off,
+        entries,
+    })
+}
+
+/// Read and concatenate a chunk's entry bytes from the disk store.
+fn fork_read_chunk_bytes(
+    chunk: &ForkChunk,
+    store: &Path,
+) -> Result<bytes::Bytes> {
+    let mut out = Vec::with_capacity(chunk.size as usize);
+    for entry in &chunk.entries {
+        let path = Path::new(store)
+            .join(&entry.k[0..1])
+            .join(&entry.k[1..2])
+            .join(&entry.k);
+        out.extend_from_slice(&std::fs::read(path)?);
+    }
+    Ok(bytes::Bytes::from(out))
+}
